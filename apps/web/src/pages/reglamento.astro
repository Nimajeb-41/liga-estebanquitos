---
/**
 * Reglamento.
 *
 * Dos bloques bien separados: lo que ya está decidido y lo que no. Una regla
 * pendiente nunca se presenta como definitiva, y las cifras del formato y de la
 * puntuación se leen de la API, no se escriben aquí.
 */
import type { Rules, TournamentOverview } from '@liga/contracts';
import { AlertTriangle, CheckCircle2 } from 'lucide-react';

import ApiFailure from '../components/ui/ApiFailure.astro';
import { Badge, Panel } from '../components/ui/primitives.tsx';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { getRules, getTournament } from '../lib/api/endpoints.ts';
import { friendlyError, type FriendlyError } from '../lib/api/messages.ts';
import { tiebreakerLabel } from '../lib/presentation.ts';
import { RULES, RULES_UPDATED_AT } from '../lib/rules-catalog.ts';
import { pageMeta } from '../lib/seo.ts';
import Public from '../layouts/Public.astro';

let rules: Rules | null = null;
let overview: TournamentOverview | null = null;
let failure: FriendlyError | null = null;

try {
  [rules, overview] = await Promise.all([getRules(), getTournament()]);
} catch (error) {
  failure = friendlyError(error);
}

const decided = RULES.filter((rule) => rule.status === 'DECIDED');
const pending = RULES.filter((rule) => rule.status === 'PENDING');

/** Las pendientes, agrupadas por urgencia tal y como las agrupa el documento. */
const pendingGroups = [...new Set(pending.map((rule) => rule.group ?? 'Pendientes'))].map(
  (group) => ({
    group,
    rules: pending.filter((rule) => (rule.group ?? 'Pendientes') === group),
  }),
);

const meta = pageMeta({
  title: 'Reglamento',
  description:
    'Reglas decididas y reglas pendientes de la Liga Estabanquitos 2026-1. Lo que no está decidido se marca como tal.',
  pathname: '/reglamento',
});
---

<Public meta={meta} rulesVersion={overview?.rulesVersion ?? null}>
  <SectionHeading
    title="Reglamento"
    description="Lo que ya se decidió y el sistema hace cumplir, separado de lo que todavía está abierto."
    level={1}
  />

  <div class="space-y-10">
    {
      failure !== null || rules === null ? (
        <ApiFailure failure={failure ?? friendlyError(new Error('sin datos'))} />
      ) : (
        <Panel as="aside">
          <h2 class="font-display text-base font-semibold">El formato en cifras</h2>
          <p class="mt-1 text-sm text-muted">
            Estos valores salen de la configuración del torneo, no de este texto.
          </p>
          <dl class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
            <div>
              <dt class="text-xs text-faint">Participantes</dt>
              <dd class="mt-0.5 font-mono">{rules.format.players}</dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Jornadas</dt>
              <dd class="mt-0.5 font-mono">{rules.format.rounds}</dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Partidos</dt>
              <dd class="mt-0.5 font-mono">{rules.format.totalMatches}</dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Coronas por partido</dt>
              <dd class="mt-0.5 font-mono">{rules.crowns.maxPerMatch}</dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Victoria</dt>
              <dd class="mt-0.5 font-mono">{rules.scoring.win} pts</dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Victoria con 3 coronas</dt>
              <dd class="mt-0.5 font-mono">{rules.scoring.winWithMaxCrowns} pts</dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Derrota</dt>
              <dd class="mt-0.5 font-mono">{rules.scoring.loss} pts</dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Empate</dt>
              <dd class="mt-0.5 font-mono">
                {rules.scoring.draw === null ? 'No existe' : `${rules.scoring.draw} pts`}
              </dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Sanción estándar</dt>
              <dd class="mt-0.5 font-mono">{rules.sanctions.defaultPoints} pts</dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Plazo de impugnación</dt>
              <dd class="mt-0.5 font-mono">{rules.disputes.windowHours} h</dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Tolerancia</dt>
              <dd class="mt-0.5 font-mono">{rules.noShow.toleranceMinutes} min</dd>
            </div>
            <div>
              <dt class="text-xs text-faint">Incomparecencia</dt>
              <dd class="mt-0.5 font-mono text-warning">
                {rules.scoring.walkoverWin === null
                  ? 'Sin decidir'
                  : `${rules.scoring.walkoverWin} pts`}
              </dd>
            </div>
          </dl>
          <p class="mt-4 border-t border-line pt-3 text-xs text-muted">
            Desempates, en orden: {rules.tiebreakers.map(tiebreakerLabel).join(' → ')}.
          </p>
        </Panel>
      )
    }

    <section aria-labelledby="reglas-decididas">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <h2 id="reglas-decididas" class="font-display text-2xl font-bold">Reglas decididas</h2>
        <Badge tone="acid" icon={CheckCircle2}>{decided.length} en vigor</Badge>
      </div>
      <p class="mb-5 max-w-2xl text-sm text-muted">
        El sistema las hace cumplir. Cada una está implementada y probada.
      </p>

      <ol class="space-y-3">
        {
          decided.map((rule) => (
            <li class="panel p-5" id={rule.id}>
              <div class="flex flex-wrap items-baseline gap-3">
                <span class="font-mono text-sm font-bold text-acid">{rule.id}</span>
                <h3 class="font-display text-lg font-semibold">{rule.title}</h3>
                {rule.decidedOn === null ? null : (
                  <span class="font-mono text-[11px] text-faint">decidida el {rule.decidedOn}</span>
                )}
              </div>
              <div class="mt-3 space-y-3 text-sm text-muted">
                {rule.blocks.map((block) =>
                  block.kind === 'list' ? (
                    <ul class="list-disc space-y-1 pl-5">
                      {(block.items ?? []).map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  ) : (
                    <p>{block.text}</p>
                  ),
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="reglas-pendientes">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <h2 id="reglas-pendientes" class="font-display text-2xl font-bold">Reglas pendientes</h2>
        <Badge tone="warning" icon={AlertTriangle}>{pending.length} sin decidir</Badge>
      </div>
      <div class="mb-5 rounded-panel border border-warning/40 bg-warning/5 px-4 py-3 text-sm">
        <p class="font-medium text-warning">Esto no son reglas: son decisiones abiertas.</p>
        <p class="mt-1 text-muted">
          Donde el sistema se topa con una de estas situaciones, falla de forma explícita en lugar
          de improvisar. No hay un valor por defecto escondido.
        </p>
      </div>

      {
        pendingGroups.map((entry) => (
          <div class="mb-6">
            <h3 class="mb-3 text-[11px] font-medium tracking-[0.12em] text-faint uppercase">
              {entry.group}
            </h3>
            <ol class="space-y-3">
              {entry.rules.map((rule) => (
                <li
                  class="rounded-panel border border-dashed border-warning/40 bg-warning/[0.03] p-5"
                  id={rule.id}
                >
                  <div class="flex flex-wrap items-baseline gap-3">
                    <span class="font-mono text-sm font-bold text-warning">{rule.id}</span>
                    <h4 class="font-display text-lg font-semibold">{rule.title}</h4>
                    <span class="rounded-full border border-warning/50 px-2.5 py-0.5 text-[10px] font-semibold tracking-[0.14em] text-warning uppercase">
                      Pendiente de definición
                    </span>
                  </div>
                  <div class="mt-3 space-y-3 text-sm text-muted">
                    {rule.blocks.map((block) =>
                      block.kind === 'list' ? (
                        <ul class="list-disc space-y-1 pl-5">
                          {(block.items ?? []).map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      ) : (
                        <p>{block.text}</p>
                      ),
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </section>

    {
      RULES_UPDATED_AT === null ? null : (
        <p class="border-t border-line pt-5 text-xs text-faint">
          Última actualización del reglamento: {RULES_UPDATED_AT}.
        </p>
      )
    }
  </div>
</Public>
