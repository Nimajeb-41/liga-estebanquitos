---
/**
 * Sanciones públicas.
 *
 * Se muestra exactamente lo que el backend marca como público: jugador, fecha,
 * tipo, motivo, puntos y estado. La evidencia y las observaciones internas se
 * quedan en administración.
 */
import type { PublicSanction, Rules, TournamentOverview } from '@liga/contracts';
import { ShieldCheck } from 'lucide-react';

import ApiFailure from '../components/ui/ApiFailure.astro';
import { Badge, EmptyState, Panel } from '../components/ui/primitives.tsx';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { getRules, getSanctions, getTournament } from '../lib/api/endpoints.ts';
import { friendlyError, type FriendlyError } from '../lib/api/messages.ts';
import { formatDate, SANCTION_STATUS_LABELS, SANCTION_TYPE_LABELS } from '../lib/presentation.ts';
import { pageMeta } from '../lib/seo.ts';
import Public from '../layouts/Public.astro';

let sanctions: PublicSanction[] = [];
let rules: Rules | null = null;
let overview: TournamentOverview | null = null;
let failure: FriendlyError | null = null;

try {
  [sanctions, rules, overview] = await Promise.all([getSanctions(), getRules(), getTournament()]);
} catch (error) {
  failure = friendlyError(error);
}

const active = sanctions.filter((sanction) => sanction.status === 'ACTIVE');
const revoked = sanctions.filter((sanction) => sanction.status !== 'ACTIVE');

const meta = pageMeta({
  title: 'Sanciones',
  description:
    'Historial público de sanciones de la Liga Estabanquitos 2026-1, con su motivo, sus puntos y su estado.',
  pathname: '/sanciones',
});
---

<Public meta={meta} rulesVersion={overview?.rulesVersion ?? null}>
  <SectionHeading
    title="Sanciones"
    description="Cada sanción resta puntos en la clasificación. Anular una deja constancia: no desaparece del historial."
    level={1}
  />

  {
    failure !== null ? (
      <ApiFailure failure={failure} />
    ) : (
      <div class="space-y-8">
        {rules === null ? null : (
          <Panel as="aside">
            <h2 class="font-display text-base font-semibold">Qué se sanciona</h2>
            <p class="mt-2 text-sm text-muted">
              El uso normal de emotes no es conducta antideportiva. Sí lo es el spam deliberado y
              persistente, la provocación repetitiva o cualquier conducta destinada a hostigar al
              rival. La decisión es del administrador; no hay ni habrá detector automático.
            </p>
            <p class="mt-3 font-mono text-xs text-faint">
              Sanción estándar: {rules.sanctions.defaultPoints} puntos · mínimo{' '}
              {rules.sanctions.minPoints}
            </p>
          </Panel>
        )}

        <section aria-labelledby="sanciones-vigentes">
          <h2 id="sanciones-vigentes" class="mb-3 font-display text-lg font-semibold">
            Vigentes
          </h2>
          {active.length === 0 ? (
            <EmptyState
              title="No hay sanciones vigentes"
              description="Ningún participante tiene puntos descontados ahora mismo."
              icon={ShieldCheck}
            />
          ) : (
            <div class="relative overflow-x-auto rounded-panel border border-line">
              <table class="w-full min-w-[38rem] border-collapse text-sm">
                <caption class="sr-only">
                  Sanciones vigentes de la Liga Estabanquitos 2026-1
                </caption>
                <thead>
                  <tr class="border-b border-line bg-elevated text-[11px] tracking-[0.1em] text-faint uppercase">
                    <th scope="col" class="px-3 py-2.5 text-left font-medium">
                      Jugador
                    </th>
                    <th scope="col" class="px-3 py-2.5 text-left font-medium">
                      Tipo
                    </th>
                    <th scope="col" class="px-3 py-2.5 text-left font-medium">
                      Motivo
                    </th>
                    <th scope="col" class="px-3 py-2.5 text-left font-medium">
                      Fecha
                    </th>
                    <th scope="col" class="px-3 py-2.5 text-right font-medium">
                      Puntos
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {active.map((sanction) => (
                    <tr class="border-b border-line/60">
                      <th scope="row" class="px-3 py-2.5 text-left font-medium">
                        {sanction.playerName}
                      </th>
                      <td class="px-3 py-2.5 text-muted">
                        {SANCTION_TYPE_LABELS[sanction.type] ?? sanction.type}
                      </td>
                      <td class="px-3 py-2.5 text-muted">{sanction.reason}</td>
                      <td class="px-3 py-2.5 font-mono text-xs text-faint">
                        {formatDate(sanction.issuedAt)}
                        {sanction.roundNumber === null ? '' : ` · J${sanction.roundNumber}`}
                      </td>
                      <td class="px-3 py-2.5 text-right font-display font-bold text-danger">
                        {sanction.points}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {revoked.length === 0 ? null : (
          <section aria-labelledby="sanciones-anuladas">
            <h2 id="sanciones-anuladas" class="mb-3 font-display text-lg font-semibold">
              Anuladas
            </h2>
            <p class="mb-3 text-sm text-muted">
              Ya no restan puntos, pero siguen en el historial: nada se borra en silencio.
            </p>
            <ul class="space-y-2">
              {revoked.map((sanction) => (
                <li class="panel flex flex-wrap items-center justify-between gap-3 p-4">
                  <span>
                    <span class="block text-sm font-medium">{sanction.playerName}</span>
                    <span class="mt-0.5 block text-sm text-muted line-through">
                      {sanction.reason}
                    </span>
                    <span class="mt-1 block font-mono text-[11px] text-faint">
                      Emitida {formatDate(sanction.issuedAt)} · anulada{' '}
                      {formatDate(sanction.revokedAt)}
                    </span>
                  </span>
                  <Badge tone="neutral">
                    {SANCTION_STATUS_LABELS[sanction.status] ?? sanction.status}
                  </Badge>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )
  }
</Public>
