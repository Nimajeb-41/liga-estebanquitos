---
/**
 * Clasificación completa.
 *
 * Acepta `?jornada=N` para ver la tabla tal y como estaba en aquella jornada.
 * El corte lo hace el backend: aquí solo se le pasa el número.
 */
import type { Standings, StandingsHistory, TournamentOverview } from '@liga/contracts';

import StandingsEvolution from '../components/standings/StandingsEvolution.astro';
import { StandingsTable } from '../components/standings/StandingsTable.tsx';
import ApiFailure from '../components/ui/ApiFailure.astro';
import { Panel } from '../components/ui/primitives.tsx';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { getStandings, getStandingsHistory, getTournament } from '../lib/api/endpoints.ts';
import { friendlyError, type FriendlyError } from '../lib/api/messages.ts';
import { tiebreakerLabel } from '../lib/presentation.ts';
import { pageMeta } from '../lib/seo.ts';
import Public from '../layouts/Public.astro';

const raw = Astro.url.searchParams.get('jornada');
const parsed = raw === null ? Number.NaN : Number(raw);
const upToRound = Number.isInteger(parsed) && parsed > 0 ? parsed : undefined;

let standings: Standings | null = null;
let overview: TournamentOverview | null = null;
let failure: FriendlyError | null = null;

try {
  [standings, overview] = await Promise.all([
    getStandings(upToRound === undefined ? {} : { upToRound }),
    getTournament(),
  ]);
} catch (error) {
  failure = friendlyError(error);
}

/*
  La evolucion es informacion adicional: si fallara, la tabla —que es lo que
  se viene a ver— tiene que seguir saliendo.
*/
let history: StandingsHistory | null = null;
try {
  history = await getStandingsHistory();
} catch {
  history = null;
}

const rounds = overview?.format.rounds ?? 0;
const meta = pageMeta({
  title: 'Clasificación',
  description:
    'Tabla de la Liga Estabanquitos 2026-1: puntos, partidos jugados, victorias, derrotas y diferencia de coronas.',
  pathname: '/clasificacion',
});
---

<Public meta={meta} rulesVersion={overview?.rulesVersion ?? null}>
  <SectionHeading
    title="Clasificación"
    description="La tabla se deriva de los resultados y las sanciones. No se almacena ni se edita a mano."
    level={1}
  />

  {
    failure !== null || standings === null ? (
      <ApiFailure failure={failure ?? friendlyError(new Error('sin datos'))} />
    ) : (
      <div class="space-y-6">
        {rounds > 0 ? (
          <nav aria-label="Ver la clasificación en una jornada" class="flex flex-wrap gap-1.5">
            <a
              href="/clasificacion"
              aria-current={upToRound === undefined ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-9 items-center rounded-md border px-3 text-xs font-medium transition-colors',
                upToRound === undefined
                  ? 'border-cyan/50 bg-cyan/10 text-cyan'
                  : 'border-line text-muted hover:border-line-strong hover:text-ink',
              ]}
            >
              Actual
            </a>
            {Array.from({ length: rounds }, (_, index) => index + 1).map((round) => (
              <a
                href={`/clasificacion?jornada=${round}`}
                aria-current={upToRound === round ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border px-2 font-mono text-xs transition-colors',
                  upToRound === round
                    ? 'border-cyan/50 bg-cyan/10 text-cyan'
                    : 'border-line text-muted hover:border-line-strong hover:text-ink',
                ]}
              >
                {String(round).padStart(2, '0')}
              </a>
            ))}
          </nav>
        ) : null}

        <StandingsTable standings={standings} client:load />

        {history === null ? null : <StandingsEvolution history={history} />}

        <Panel as="aside">
          <h2 class="font-display text-base font-semibold">Cómo se ordena</h2>
          <p class="mt-2 text-sm text-muted">
            Cuando dos participantes suman los mismos puntos, se aplican estos criterios en orden
            hasta deshacer el empate:
          </p>
          <ol class="mt-3 space-y-1.5 text-sm">
            {standings.tiebreakers.map((key, index) => (
              <li class="flex gap-3">
                <span class="font-mono text-xs text-faint">{index + 1}.</span>
                <span>{tiebreakerLabel(key)}</span>
              </li>
            ))}
          </ol>
          <p class="mt-4 text-xs text-muted">
            Si tras todos ellos dos participantes siguen exactamente iguales, comparten posición y
            se marca en la tabla. Qué hacer entonces es una regla todavía pendiente (P-09):{' '}
            <a href="/reglamento" class="text-cyan underline-offset-2 hover:underline">
              ver reglamento
            </a>
            .
          </p>
        </Panel>
      </div>
    )
  }
</Public>
