---
/**
 * Temporada.
 *
 * Todo lo que define la competición antes de que se juegue nada: quién es,
 * cuándo se prevé, con qué reglas, en qué estado, y qué haría falta para
 * cerrarla.
 *
 * Es la pantalla que responde a «¿qué estoy administrando exactamente?», y por
 * eso el estado y el reglamento viven juntos: cambiar uno cambia lo que se
 * puede hacer con el otro.
 */
import type {
  ClosureReport,
  ConfigurableSettings,
  SeasonSnapshotSummary,
  TournamentOverview,
} from '@liga/contracts';
import { CalendarClock, FileClock } from 'lucide-react';

import { SeasonSettings } from '../../components/admin/SeasonSettings.tsx';
import { TournamentControls } from '../../components/admin/TournamentControls.tsx';
import ApiFailure from '../../components/ui/ApiFailure.astro';
import { EmptyState, Panel, StatTile } from '../../components/ui/primitives.tsx';
import {
  getClosureReport,
  getConfigurableSettings,
  getSeasonSnapshots,
  getTournament,
} from '../../lib/api/endpoints.ts';
import { friendlyError, type FriendlyError } from '../../lib/api/messages.ts';
import { currentSession, sessionHeader } from '../../lib/api/session.ts';
import { formatDateTime, tournamentStatusLabel } from '../../lib/presentation.ts';
import Admin from '../../layouts/Admin.astro';

const session = await currentSession(Astro.cookies).catch(() => null);
if (session === null) return Astro.redirect('/admin/login?next=/admin/temporada');

const cookie = sessionHeader(Astro.cookies);

let overview: TournamentOverview | null = null;
let settings: ConfigurableSettings | null = null;
let closure: ClosureReport | null = null;
let snapshots: SeasonSnapshotSummary[] = [];
let failure: FriendlyError | null = null;

try {
  [overview, settings, closure, snapshots] = await Promise.all([
    getTournament(),
    getConfigurableSettings({ cookie }),
    getClosureReport({ cookie }),
    getSeasonSnapshots({ cookie }),
  ]);
} catch (error) {
  failure = friendlyError(error);
}

/** Qué significa cada bloqueo, en palabras. El código es estable; el texto, no. */
const BLOCKER_LABEL: Readonly<Record<string, string>> = {
  MATCHES_NOT_PLAYED: 'partidos sin jugar',
  MATCHES_LIVE: 'partidos en juego',
  MATCHES_POSTPONED: 'partidos aplazados',
  MATCHES_DISPUTED: 'resultados en disputa',
  NO_FIXTURE: 'no hay calendario generado',
};
---

<Admin
  title="Temporada"
  description="Identidad, fechas, reglamento y estado de la competición."
  session={session}
>
  {
    failure !== null || overview === null || settings === null || closure === null ? (
      <ApiFailure failure={failure ?? friendlyError(new Error('sin datos'))} />
    ) : (
      <div class="space-y-6">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
          <StatTile label="Estado" value={tournamentStatusLabel(overview.status)} tone="cyan" />
          <StatTile
            label="Reglamento"
            value={overview.rulesVersion}
            hint={`${settings.parameters.filter((entry) => entry.editable).length} parámetros ajustables`}
          />
          <StatTile
            label="Participantes"
            value={`${overview.roster.confirmed}/${overview.roster.rosterSize}`}
            tone={overview.roster.complete ? 'acid' : 'warning'}
          />
          <StatTile
            label="Calendario"
            value={overview.fixture.generated ? `${overview.fixture.matches}` : 'Sin generar'}
            hint={overview.fixture.generated ? 'partidos' : undefined}
          />
          <StatTile
            label="Progreso"
            value={`${overview.progress.completed}/${overview.progress.total}`}
            hint="finalizados"
          />
        </div>

        <TournamentControls overview={overview} client:load />

        <section class="panel p-5" aria-labelledby="fechas">
          <h2 id="fechas" class="flex items-center gap-2 font-display text-base font-semibold">
            <CalendarClock aria-hidden="true" className="size-4 text-cyan" />
            Calendario de la temporada
          </h2>
          <dl class="mt-4 grid gap-4 sm:grid-cols-4">
            <div>
              <dt class="text-[11px] tracking-[0.12em] text-faint uppercase">Inicio previsto</dt>
              <dd class="mt-0.5 text-sm">{formatDateTime(overview.plannedStartAt)}</dd>
            </div>
            <div>
              <dt class="text-[11px] tracking-[0.12em] text-faint uppercase">Fin previsto</dt>
              <dd class="mt-0.5 text-sm">{formatDateTime(overview.plannedEndAt)}</dd>
            </div>
            <div>
              <dt class="text-[11px] tracking-[0.12em] text-faint uppercase">Empezó</dt>
              <dd class="mt-0.5 text-sm">{formatDateTime(overview.startedAt)}</dd>
            </div>
            <div>
              <dt class="text-[11px] tracking-[0.12em] text-faint uppercase">Terminó</dt>
              <dd class="mt-0.5 text-sm">{formatDateTime(overview.finishedAt)}</dd>
            </div>
          </dl>
          <p class="mt-3 text-xs text-muted">
            Las dos primeras son planes; las dos últimas, hechos. Se guardan por separado para poder
            decir que la liga empezó tarde en vez de reescribir la intención original.
          </p>
        </section>

        <SeasonSettings overview={overview} settings={settings} client:load />

        <section class="panel p-5" aria-labelledby="cierre">
          <h2 id="cierre" class="font-display text-base font-semibold">
            Cierre de la temporada
          </h2>

          {closure.closeable ? (
            <p class="mt-3 text-sm text-acid">
              No queda nada sin resolver: la temporada se puede cerrar.
            </p>
          ) : (
            <>
              <p class="mt-3 text-sm text-muted">
                Queda esto sin resolver. Cerrar igualmente es posible, pero hay que reconocerlo
                expresamente y queda escrito así en la auditoría.
              </p>
              <ul class="mt-3 space-y-1.5">
                {closure.blockers.map((blocker) => (
                  <li class="flex items-baseline gap-2 text-sm">
                    <span class="font-mono text-warning">{blocker.count}</span>
                    <span class="text-muted">{BLOCKER_LABEL[blocker.code] ?? blocker.code}</span>
                  </li>
                ))}
              </ul>
            </>
          )}

          <p class="mt-4 border-t border-line pt-3 text-xs text-muted">
            Cerrar es definitivo: de <code>FINISHED</code> no se sale. Al cerrar se genera una
            instantánea con la clasificación final y las reglas con las que se calculó, porque la
            tabla <strong>se deriva</strong> y cambiaría si el reglamento cambiara después.
          </p>
          <p class="mt-2 text-xs text-faint">
            Lo que quede sin jugar se queda como está y no puntúa. Qué hacer con ello —abandono
            (P-05), incomparecencia sin declarar (R-09) o aplazamiento sin fecha (P-08)— es una
            decisión de reglamento, no del sistema.
          </p>
        </section>

        <section class="panel p-5" aria-labelledby="instantaneas">
          <h2
            id="instantaneas"
            class="flex items-center gap-2 font-display text-base font-semibold"
          >
            <FileClock aria-hidden="true" className="size-4 text-cyan" />
            Instantáneas
          </h2>

          {snapshots.length === 0 ? (
            <div class="mt-4">
              <EmptyState
                title="Todavía ninguna"
                description="Se genera una al cerrar la temporada, con la clasificación final y el reglamento con el que se calculó."
              />
            </div>
          ) : (
            <ul class="mt-4 space-y-2">
              {snapshots.map((snapshot) => (
                <li class="rounded-md border border-line px-3 py-2.5 text-sm">
                  <p class="flex flex-wrap items-center justify-between gap-2">
                    <span class="font-medium">{formatDateTime(snapshot.closedAt)}</span>
                    <span class="font-mono text-[11px] text-faint">
                      reglamento {snapshot.rulesVersion} · formato {snapshot.format}
                    </span>
                  </p>
                  <p class="mt-1 text-muted">{snapshot.reason}</p>
                  <p class="mt-1 text-xs text-faint">
                    Cerrada por {snapshot.closedBy ?? 'desconocido'}
                    {snapshot.closedWithPending ? ' · con asuntos sin resolver' : ''}
                  </p>
                </li>
              ))}
            </ul>
          )}
        </section>

        <Panel as="aside">
          <h2 class="font-display text-base font-semibold">
            Por qué esto está aquí y no en el código
          </h2>
          <p class="mt-2 text-sm text-muted">
            La puntuación, la tolerancia y el plazo de impugnación son decisiones de esta temporada,
            no leyes del juego. El reglamento público las publica marcadas como ajustables
            precisamente para que nadie las lea como inamovibles.
          </p>
          <p class="mt-2 text-sm text-muted">
            Lo que no se ajusta desde aquí son las once reglas pendientes: esas no son parámetros,
            son decisiones que nadie ha tomado todavía.
          </p>
        </Panel>
      </div>
    )
  }
</Admin>
