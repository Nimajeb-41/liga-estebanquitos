---
/**
 * Esqueleto de todas las páginas.
 *
 * Aquí viven el idioma, los metadatos, las fuentes y la hoja de estilos. Nada
 * de esto se repite en las páginas.
 */
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';

import SiteRuntime from '../components/layout/SiteRuntime.astro';
import { SITE_NAME, SITE_SEASON, type PageMeta } from '../lib/seo.ts';

interface Props {
  meta: PageMeta;
  /** Clase extra para el `<body>`, por si una página necesita un fondo propio. */
  bodyClass?: string;
}

const { meta, bodyClass = '' } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    {meta.noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <meta name="theme-color" content="#05060a" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/pwa/icon-192.png" />

    <!--
      PWA. El manifiesto va en todas las páginas porque una instalación puede
      arrancar desde cualquiera: nadie llega siempre por la portada.
    -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!--
      Transiciones entre páginas. Astro navega sin recargar el documento, lo
      que además deja vivo el interruptor de sonido y el service worker.
    -->
    <ClientRouter />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${SITE_NAME} ${SITE_SEASON}`} />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:image" content={meta.image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image} />

    <!--
      Las dos familias de la dirección visual, subconjunto latino y `swap`: si
      no llegan, el sistema pone las suyas y la página se lee igual.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body class={bodyClass}>
    {
      /*
      El primer elemento enfocable de toda la página, y el único que existe solo
      para quien navega con teclado.

      Su CSS está en `global.css` en vez de en clases de utilidad porque
      `sr-only` y `focus:not-sr-only` se disputan las mismas propiedades: la
      combinación funciona, pero depende de cómo se ordenen las utilidades al
      generarse. Una regla propia hace que no dependa de nada.
    */
    }
    <a href="#contenido" class="skip-link"> Saltar al contenido </a>
    <slot />
    <SiteRuntime />
  </body>
</html>
