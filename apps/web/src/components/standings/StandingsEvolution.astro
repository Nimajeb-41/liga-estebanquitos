---
/**
 * Evolución de la clasificación.
 *
 * Una fila por participante y una columna por jornada jugada, con la posición
 * que ocupaba entonces. Es la pregunta que se hace sola al mirar una tabla:
 * «¿esto viene de lejos o es de esta semana?».
 *
 * Se dibuja con números, no con una gráfica. Con diez participantes y dieciocho
 * jornadas, una línea por jugador sería ilegible; y la posición es un dato
 * discreto, no una curva.
 *
 * Importa una cosa que la pantalla dice explícitamente: esto **se recalcula**
 * con el reglamento vigente. No es un archivo histórico, porque la
 * clasificación tampoco se guarda.
 */
import type { StandingsHistory } from '@liga/contracts';

import { EmptyState } from '../ui/primitives.tsx';

interface Props {
  history: StandingsHistory;
}

const { history } = Astro.props;

/** Ordenadas por la posición de la última jornada: se lee como la tabla. */
const players = [...history.players]
  .filter((player) => player.points.length > 0)
  .sort((a, b) => {
    const last = (entry: (typeof a)['points']) => entry[entry.length - 1]?.position ?? 99;
    return last(a.points) - last(b.points);
  });

/** Posición en esa jornada, o `null` si el participante no figuraba aún. */
function positionAt(
  player: StandingsHistory['players'][number],
  round: number,
): { position: number; change: number | null } | null {
  const index = player.points.findIndex((point) => point.round === round);
  if (index < 0) return null;
  const current = player.points[index]!;
  const previous = player.points[index - 1];
  return {
    position: current.position,
    change: previous === undefined ? null : previous.position - current.position,
  };
}
---

<section class="panel p-5" aria-labelledby="evolucion">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 id="evolucion" class="font-display text-base font-semibold">Evolución por jornada</h2>
    <p class="font-mono text-[11px] text-faint">reglamento {history.rulesVersion}</p>
  </div>

  {
    players.length === 0 || history.rounds.length === 0 ? (
      <div class="mt-4">
        <EmptyState
          title="Todavía no hay nada que seguir"
          description="La evolución aparece en cuanto se juegue la primera jornada."
        />
      </div>
    ) : (
      <>
        <div class="relative mt-4 overflow-x-auto">
          <table class="w-full min-w-[36rem] border-collapse text-sm">
            <caption class="sr-only">
              Posición de cada participante al terminar cada jornada
            </caption>
            <thead>
              <tr class="border-b border-line text-[11px] tracking-[0.12em] text-faint uppercase">
                <th scope="col" class="py-2 pr-3 text-left font-medium">
                  Participante
                </th>
                {history.rounds.map((round) => (
                  <th scope="col" class="px-1.5 py-2 text-center font-medium">
                    {String(round).padStart(2, '0')}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {players.map((player) => (
                <tr class="border-b border-line/60 last:border-0">
                  <th scope="row" class="py-2 pr-3 text-left font-medium whitespace-nowrap">
                    <a href={`/jugadores/${player.slug}`} class="transition-colors hover:text-cyan">
                      {player.displayName}
                    </a>
                  </th>
                  {history.rounds.map((round) => {
                    const cell = positionAt(player, round);
                    return (
                      <td class="px-1.5 py-2 text-center font-mono tabular-nums">
                        {cell === null ? (
                          <span class="text-faint">·</span>
                        ) : (
                          <span
                            class:list={[
                              cell.position === 1 ? 'text-acid' : '',
                              cell.change !== null && cell.change > 0 ? 'text-cyan' : '',
                              cell.change !== null && cell.change < 0 ? 'text-warning' : '',
                            ]}
                            title={
                              cell.change === null || cell.change === 0
                                ? undefined
                                : cell.change > 0
                                  ? `Subió ${cell.change}`
                                  : `Bajó ${Math.abs(cell.change)}`
                            }
                          >
                            {cell.position}
                          </span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-4 border-t border-line pt-3 text-xs text-muted">
          Cada número es la posición al terminar esa jornada, recalculada con el reglamento vigente.
          No es un archivo: si la puntuación cambiara, esta cuadrícula cambiaría con ella, igual que
          la tabla. Un punto <span class="text-faint">·</span> significa que aún no había jugado
          nada.
        </p>
      </>
    )
  }
</section>
