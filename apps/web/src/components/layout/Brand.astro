---
/**
 * Marca de la liga.
 *
 * El logotipo definitivo todavía no existe: hasta que llegue se usa un
 * monograma tipográfico deliberadamente sobrio, que nadie pueda confundir con
 * la identidad oficial. Cuando exista el archivo, se sustituye solo esto.
 *
 * Ver docs/branding-and-assets.md.
 */
interface Props {
  size?: 'sm' | 'md';
  href?: string | null;
}

const { size = 'md', href = '/' } = Astro.props;
const box = size === 'sm' ? 'size-8 text-sm' : 'size-10 text-base';
const Tag = href === null ? 'span' : 'a';
---

<Tag
  {...href === null ? {} : { href }}
  class="group inline-flex items-center gap-3 rounded-lg focus-visible:outline-none"
>
  <span
    aria-hidden="true"
    class={`${box} relative inline-flex shrink-0 items-center justify-center rounded-lg border border-cyan/40 bg-panel font-display font-bold text-cyan transition-colors group-hover:border-cyan`}
  >
    LE
    <span
      class="absolute inset-0 rounded-lg opacity-0 transition-opacity group-hover:opacity-100"
      style="box-shadow: var(--shadow-glow-cyan)"></span>
  </span>
  <span class="flex flex-col leading-tight">
    <span class="font-display text-sm font-semibold tracking-wide">LIGA ESTABANQUITOS</span>
    <span class="font-mono text-[10px] tracking-[0.22em] text-faint">TEMPORADA 2026-1</span>
  </span>
</Tag>
