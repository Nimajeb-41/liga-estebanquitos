---
/**
 * Centro de acción.
 *
 * El resumen ya dice cuántas cosas hay pendientes. Esto dice cuáles, y lleva a
 * cada una.
 *
 * El orden es por antigüedad, no por gravedad: decidir que una disputa importa
 * más que un aplazado sería una regla de competición, y esa no la inventa una
 * pantalla. Lo que no tiene fecha va al final porque no hay nada honesto que
 * ordenar, no porque sea reciente.
 */
import type { AttentionItem, AttentionKind, AttentionReport } from '@liga/contracts';
import type { LucideIcon } from 'lucide-react';
import { CalendarX, CircleHelp, Clock, PauseCircle, Radio, Scale, SearchCheck } from 'lucide-react';

import { EmptyState } from '../ui/primitives.tsx';
import { formatDateTime, roundLabel } from '../../lib/presentation.ts';

interface Props {
  report: AttentionReport;
  /** Cuántos enumerar. El resto se resume en una línea. */
  limit?: number;
}

const { report, limit = 12 } = Astro.props;

/** Qué es cada cosa, y qué se espera de quien la lee. */
const KIND: Readonly<
  Record<AttentionKind, { label: string; hint: string; tone: string; icon: LucideIcon }>
> = {
  DISPUTED: {
    label: 'En disputa',
    hint: 'Fuera de la tabla hasta que administración decida.',
    tone: 'text-danger',
    icon: Scale,
  },
  LIVE: {
    label: 'En directo',
    hint: 'Marcado como en juego. Si ya terminó, falta registrar el resultado.',
    tone: 'text-magenta',
    icon: Radio,
  },
  POSTPONED_WITHOUT_DATE: {
    label: 'Aplazado sin fecha',
    hint: 'Aplazado y todavía sin día nuevo.',
    tone: 'text-warning',
    icon: PauseCircle,
  },
  OVERDUE: {
    label: 'Fecha pasada',
    hint: 'Pasó la hora prevista y sigue sin resultado.',
    tone: 'text-warning',
    icon: Clock,
  },
  UNSCHEDULED: {
    label: 'Sin fecha',
    hint: 'En el calendario, pero sin día asignado.',
    tone: 'text-muted',
    icon: CalendarX,
  },
  CANDIDATE_PENDING: {
    label: 'Candidato por revisar',
    hint: 'Una batalla propuesta que nadie ha confirmado ni descartado.',
    tone: 'text-cyan',
    icon: SearchCheck,
  },
  BATTLE_NEEDS_REVIEW: {
    label: 'Batalla con conflicto',
    hint: 'El importador marcó algo que no cuadraba.',
    tone: 'text-cyan',
    icon: CircleHelp,
  },
};

const shown: AttentionItem[] = report.items.slice(0, limit);
const rest = report.total - shown.length;
---

<section class="panel p-5" aria-labelledby="centro-accion">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 id="centro-accion" class="font-display text-base font-semibold">Centro de acción</h2>
    <p class="font-mono text-[11px] text-faint">
      {report.total === 0 ? 'nada pendiente' : `${report.total} sin resolver`}
    </p>
  </div>

  {
    report.total === 0 ? (
      <div class="mt-4">
        <EmptyState
          title="Todo al día"
          description="No hay partidos atascados ni evidencia esperando revisión."
        />
      </div>
    ) : (
      <>
        <ul class="mt-4 space-y-2">
          {shown.map((item) => {
            const meta = KIND[item.kind];
            const Icon = meta.icon;
            return (
              <li>
                <a
                  href={item.href}
                  class="flex flex-wrap items-start justify-between gap-3 rounded-md border border-line px-3 py-2.5 transition-colors hover:border-cyan/40"
                >
                  <span class="flex min-w-0 items-start gap-2.5">
                    <Icon aria-hidden="true" className={`mt-0.5 size-4 shrink-0 ${meta.tone}`} />
                    <span class="min-w-0">
                      <span class="block truncate text-sm font-medium">{item.label}</span>
                      <span class="block text-xs text-muted">{meta.hint}</span>
                    </span>
                  </span>
                  <span class="shrink-0 text-right">
                    <span class={`block text-xs font-medium ${meta.tone}`}>{meta.label}</span>
                    <span class="block font-mono text-[11px] text-faint">
                      {item.roundNumber === null ? '' : `${roundLabel(item.roundNumber)} · `}
                      {item.since === null ? 'sin fecha' : formatDateTime(item.since)}
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>

        {rest > 0 ? (
          <p class="mt-3 text-xs text-muted">
            Y {rest} {rest === 1 ? 'asunto más' : 'asuntos más'}.{' '}
            <a href="/admin/matches" class="text-cyan underline-offset-2 hover:underline">
              Ver todos los partidos
            </a>
            .
          </p>
        ) : null}
      </>
    )
  }

  <p class="mt-4 border-t border-line pt-3 text-xs text-faint">
    Ordenado por antigüedad, no por gravedad: qué pesa más es una decisión de reglamento, no del
    panel. Esta lista enumera; las acciones siguen en la ficha de cada partido, con sus
    confirmaciones.
  </p>
</section>
