# Copiar a .env y rellenar. .env NUNCA se sube al repositorio.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000

# Torneo que sirve esta instancia.
TOURNAMENT_SLUG=liga-estabanquitos-2026-1

# PostgreSQL
DATABASE_URL=postgres://liga:liga@localhost:5432/liga_estabanquitos

# Sesion administrativa
SESSION_TTL_HOURS=12

# Origenes permitidos por CORS, separados por comas. Vacio = solo mismo origen.
# En produccion no se admite "*".
CORS_ORIGINS=

# Administrador inicial que crea el seed (minimo 12 caracteres).
ADMIN_EMAIL=admin@liga-estabanquitos.local
ADMIN_PASSWORD=

# API oficial de Clash Royale (developer.clashroyale.com).
# Solo la usa el backend. NUNCA se expone al frontend ni se sube al repositorio.
# El token esta ligado a las IP que se declaren al crearlo.
CLASH_ROYALE_API_TOKEN=
CLASH_ROYALE_API_BASE_URL=https://api.clashroyale.com/v1

# Sin token la integracion no se activa, se pida o no.
CLASH_ROYALE_ENABLED=true
CLASH_ROYALE_TIMEOUT_MS=8000
CLASH_ROYALE_MAX_RETRIES=3

# Margen alrededor de la hora prevista dentro del cual una batalla se considera
# creible para ese partido. NO sale de ninguna medicion: el spike no midio esto.
# Ajustar cuando la liga lleve jornadas jugadas.
CLASH_ROYALE_MATCH_WINDOW_MINUTES=180

# Sincronizacion automatica: APAGADA a proposito. La frecuencia adecuada depende
# de cuanto conserva Clash Royale el historial, y de eso solo se conoce la cota
# inferior (>= 41,4 h). Ver docs/clash-royale-integration.md.
CLASH_ROYALE_SYNC_ENABLED=false
CLASH_ROYALE_SYNC_INTERVAL_MINUTES=60

# Cuantos participantes se consultan por vuelta. Deliberadamente bajo: la API
# oficial no publica sus limites de peticiones y el spike no los midio. Es
# preferible tardar en recorrer la plantilla a perder el acceso a mitad de
# temporada.
CLASH_ROYALE_SYNC_MAX_PLAYERS=3

# Cortacircuitos. Tras N fallos seguidos la sincronizacion se detiene durante el
# enfriamiento. Sin esto, un token caducado o una IP que cambio producirian un
# 403 por jugador y por vuelta, indefinidamente.
CLASH_ROYALE_BREAKER_FAILURES=3
CLASH_ROYALE_BREAKER_COOLDOWN_MINUTES=15

# ---------------------------------------------------------------------------
# Frontend (apps/web)
# ---------------------------------------------------------------------------

# URL de la API vista desde el servidor de Astro. Puede ser una direccion
# interna: el navegador no la usa.
API_URL=http://127.0.0.1:3000

# URL de la API vista desde el navegador. Solo hace falta si algun dia el
# navegador tuviera que llamarla directamente; hoy no lo hace.
PUBLIC_API_URL=

# Origen publico del sitio. Se usa en canonical, sitemap y Open Graph.
PUBLIC_SITE_URL=http://127.0.0.1:4321

# Segundos entre sondeos de un partido en directo. Minimo 5, por defecto 20.
PUBLIC_LIVE_POLL_SECONDS=20

# Donde escucha el frontend en desarrollo.
WEB_HOST=127.0.0.1
WEB_PORT=4321
